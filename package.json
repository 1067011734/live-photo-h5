{
  "name": "@local/live-photo-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform React Live Photo player and Motion Photo importer",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "heic-to": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/live-photo.js"
    },
    "./style.css": "./lib/live-photo.css"
  },
  "files": [
    "lib"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
